rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if me(uid);
      allow update: if me(uid);
      allow delete: if me(uid);
      match /following/{target} { allow read, write: if me(uid); }
      match /followingFeed/{videoId} { allow read: if me(uid); }
      match /followers/{follower} { allow read: if signedIn(); allow write: if me(uid) || me(follower); }
      match /notifications/{id} { allow read, delete: if me(uid); }
    }
    match /hashtags/{tag} { allow read: if signedIn(); }
    match /videos/{videoId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount','viewCount','commentCount'])
      );
      match /likes/{uid} { allow read: if signedIn(); allow create, delete: if me(uid); }
      match /comments/{id} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }
    }
  }
}
